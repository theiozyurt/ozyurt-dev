---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  descriptionTr?: string;
  path?: string;
  sheet?: string;              // "01" … "08": alt bilgide "Sayfa NN / 08"
  footer?: 'talk' | 'name';
}

const {
  title,
  description = site.description.en,
  descriptionTr = site.description.tr,
  path = '',
  sheet,
  footer = 'talk',
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role.en}`;
const canonical = new URL(path, Astro.site ?? 'https://ozyurt.dev').href;
const ogImage = new URL('/og.jpg?v=3', Astro.site ?? 'https://ozyurt.dev').href;
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F4F4F0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} data-desc-tr={descriptionTr} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="tr_TR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: kendi sunucumuzda (OFL). Latin alt kümeleri önceden yüklenir. -->
    <link rel="preload" href="/fonts/archivo-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.name,
      url: 'https://ozyurt.dev',
      email: `mailto:${site.email}`,
      jobTitle: site.role.en,
      address: { '@type': 'PostalAddress', addressLocality: 'Kütahya', addressCountry: 'TR' },
      sameAs: [site.linkedin, site.github],
    })} />

    <!-- Dil: boyamadan önce kayıttan oku (titreme olmasın) -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('lang');
          var lang = stored === 'tr' || stored === 'en' ? stored : 'en';
          document.documentElement.setAttribute('data-lang', lang);
          document.documentElement.setAttribute('lang', lang);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main"><span data-lang="en">Skip to content</span><span data-lang="tr" lang="tr">İçeriğe geç</span></a>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer sheet={sheet} variant={footer} />
    <Lightbox />

    <script is:inline>
      // Dil geçişi — data-lang özniteliği + localStorage
      (function () {
        function sync(lang) {
          document.querySelectorAll('[data-lang-set]').forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-lang-set') === lang ? 'true' : 'false');
          });
          var meta = document.querySelector('meta[name="description"]');
          if (meta) {
            if (!meta.dataset.descEn) meta.dataset.descEn = meta.getAttribute('content');
            meta.setAttribute('content', lang === 'tr' ? meta.dataset.descTr : meta.dataset.descEn);
          }
          document.dispatchEvent(new CustomEvent('langchange', { detail: lang }));
        }
        document.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-lang-set]');
          if (!btn) return;
          var lang = btn.getAttribute('data-lang-set');
          document.documentElement.setAttribute('data-lang', lang);
          document.documentElement.setAttribute('lang', lang);
          try { localStorage.setItem('lang', lang); } catch (e) {}
          sync(lang);
        });
        sync(document.documentElement.getAttribute('data-lang') || 'en');
      })();
    </script>
  </body>
</html>
