---
/**
 * Paylaşılan galeri — /projects/[slug], /experience/[slug], /leadership/[slug]
 * ve Ceviz vaka sayfasında kullanılır. Görsel yoksa hiçbir şey basmaz.
 * Tıklanınca BaseLayout'taki Lightbox açılır (data-lightbox-group).
 */
import T from './T.astro';

interface Props {
  images?: string[];
  heading?: { en: string; tr: string };
  phone?: boolean;   // telefon ekran görüntüleri: dar ve uzun karolar
}
const { images = [], heading = { en: 'Gallery', tr: 'Galeri' }, phone = false } = Astro.props;
---
{images.length > 0 && (
  <div class="gallery">
    <p class="k gallery-k"><T t={heading} /> · {String(images.length).padStart(2, '0')}</p>
    <div class:list={['grid', { phone }]} data-lightbox-group>
      {images.map((img, i) => (
        <button class="item" type="button" data-lightbox aria-label={`Open image ${i + 1} / Görsel ${i + 1}`}>
          <img src={img} alt="" loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  </div>
)}

<style>
  .gallery { display: flex; flex-direction: column; gap: 14px; }
  .gallery-k { padding-top: 14px; border-top: 1.5px solid var(--ink); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr)); gap: 12px; }
  .grid.phone { grid-template-columns: repeat(auto-fill, minmax(min(150px, 45%), 1fr)); }
  .item {
    display: block;
    padding: 0;
    border: 1.5px solid var(--ink);
    background: var(--card);
    cursor: zoom-in;
    overflow: hidden;
  }
  .item img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 0.4s var(--ease); }
  .grid.phone .item img { aspect-ratio: 9 / 19.5; object-position: top; }
  .item:hover img { transform: scale(1.03); }
</style>
