---
// Çift dil geçişi. Tıklama BaseLayout içinde global olarak dinleniyor.
---
<div class="lang" role="group" aria-label="Language / Dil">
  <button type="button" data-lang-set="en" aria-pressed="true">EN</button>
  <button type="button" data-lang-set="tr" aria-pressed="false" lang="tr">TR</button>
</div>

<style>
  .lang {
    display: flex;
    gap: 2px;
    padding: 2px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
  }
  .lang button {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: 700 13px/1 var(--font-body);
    cursor: pointer;
  }
  .lang button:hover { background: var(--paper-hover); }
  .lang button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
</style>
