---
import site from '../data/site.json';
import T from './T.astro';

interface Props {
  sheet?: string;            // "01" … "08" — sayfanın numarası
  variant?: 'talk' | 'name'; // iletişim sayfasında "Konuşalım" yerine isim
}
const { sheet, variant = 'talk' } = Astro.props;
const total = String(site.nav.length).padStart(2, '0');
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap ftr-top">
    {variant === 'talk' ? (
      <div class="ftr-talk">
        <p class="disp ftr-big"><T en="Let’s talk." tr="Konuşalım." /></p>
        <a class="btn btn--ink" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span></a>
      </div>
    ) : (
      <p class="disp ftr-big ftr-name" lang="tr">İsmail Özyurt<span>.dev</span></p>
    )}

    <nav class="ftr-col" aria-label="Footer">
      <p class="k"><T en="Sheets" tr="Sayfalar" /></p>
      {site.nav.map((n, i) => (
        <a href={n.href}><span class="ftr-n">{String(i + 1).padStart(2, '0')}</span><T en={n.en} tr={n.tr} /></a>
      ))}
    </nav>

    <div class="ftr-col">
      <p class="k"><T en="Elsewhere" tr="Diğer adresler" /></p>
      <a href={site.linkedin} rel="me">LinkedIn ↗</a>
      <a href={site.github} rel="me">GitHub ↗</a>
      <a href={site.cevizSite} lang="tr">Ceviz Biyoteknoloji ↗</a>
      <a href="https://ismail.ozyurt.dev">ismail.ozyurt.dev ↗</a>
    </div>
  </div>

  <div class="wrap ftr-base">
    <span>© {year} <span lang="tr">İsmail Özyurt</span></span>
    <span>ozyurt.dev{sheet ? <> · <T en={`Sheet ${sheet} / ${total}`} tr={`Sayfa ${sheet} / ${total}`} /></> : null}</span>
    <span lang="tr">Kütahya, Türkiye</span>
  </div>
</footer>

<style>
  .ftr { border-top: 6px solid var(--ink); }
  .ftr-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 40px;
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: 40px;
  }
  .ftr-talk { flex: 1 1 420px; display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .ftr-big { font-size: clamp(52px, 6.4vw, 96px); line-height: 0.84; letter-spacing: -0.05em; }
  .ftr-name { flex: 1 1 420px; font-size: clamp(48px, 6vw, 88px); }
  .ftr-name span { color: var(--blue); }

  .ftr-col { flex: 0 1 220px; display: flex; flex-direction: column; gap: 2px; font-weight: 600; font-size: 15px; }
  .ftr-col .k { margin-bottom: 8px; }
  .ftr-col a { display: flex; align-items: center; min-height: 32px; text-decoration: none; }
  .ftr-n { min-width: 2.1em; font-variant-numeric: tabular-nums; }

  .ftr-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 16px;
    padding-bottom: 32px;
    border-top: 1px solid var(--rule);
    color: var(--ink-3);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
