---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrintTitle from '../../components/PrintTitle.astro';
import Stamp from '../../components/Stamp.astro';
import Gallery from '../../components/Gallery.astro';
import T from '../../components/T.astro';
import leadership from '../../data/leadership.json';
import stamps from '../../data/stamps.json';

export function getStaticPaths() {
  return leadership.map((item, i) => ({
    params: { slug: item.slug },
    props: { item, i },
  }));
}

const { item, i } = Astro.props;
const bi = (v: any) => (typeof v === 'string' ? { en: v, tr: v } : v);
const org = bi(item.org);
const s = (stamps as Record<string, any>)[item.slug] ?? {};
const points = ((item as any).points ?? []).map(bi);
const gallery: string[] = (item as any).gallery ?? [];
const next = leadership[(i + 1) % leadership.length];
---

<BaseLayout
  path={`/leadership/${item.slug}`}
  title={org.en}
  sheet="05"
  description={bi(item.summary).en}
  descriptionTr={bi(item.summary).tr}
>
  <section class="wrap sheet">
    <div class="sheet-row">
      <a class="back k" href="/leadership">← <T en="Sheet 05 · Leadership" tr="Sayfa 05 · Liderlik" /></a>
      <p class="k"><T t={bi(item.period)} /></p>
    </div>
    <div class="detail-intro">
      <div class="detail-intro-text">
        <p class="k" style={`color: ${s.ink}`}><T t={bi(item.role)} /></p>
        <PrintTitle en={org.en} tr={org.tr} size="clamp(44px, 6.4vw, 104px)" />
      </div>
      <Stamp slug={item.slug} size={220} delay={0.3} />
    </div>
  </section>

  <section class="wrap sec">
    <div class="detail">
      <div class="detail-main">
        <p class="detail-summary"><T t={bi(item.summary)} /></p>
        {points.length > 0 && (
          <ul class="plain bullets" style={`--dot: ${s.ink}`}>
            {points.map((p: any) => <li><span><T t={p} /></span></li>)}
          </ul>
        )}
        {s.stat && (
          <p class="stat"><span class="disp stat-n">{s.stat}</span><span class="stat-l"><T t={s.statLabel} /></span></p>
        )}
        {gallery.length > 0 && <Gallery images={gallery} />}
      </div>
      <dl class="facts">
        <div><dt class="k"><T en="Role" tr="Rol" /></dt><dd><T t={bi(item.role)} /></dd></div>
        <div><dt class="k"><T en="Organization" tr="Kurum" /></dt><dd><T t={org} /></dd></div>
        <div><dt class="k"><T en="Period" tr="Dönem" /></dt><dd><T t={bi(item.period)} /></dd></div>
      </dl>
    </div>
  </section>

  <section class="wrap sec">
    <div class="next-row">
      <a class="btn" href="/leadership">← <T en="All roles" tr="Tüm roller" /></a>
      <a class="ulink" href={`/leadership/${next.slug}`}><T en="Next:" tr="Sıradaki:" />&nbsp;<T t={bi(next.org)} /> →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .stat { align-self: flex-start; display: flex; align-items: baseline; gap: 10px; padding: 10px 16px; border: 1.5px dashed var(--ink); }
  .stat-n { font-size: 40px; line-height: 1; }
  .stat-l { font-weight: 600; font-size: 14px; }
</style>
