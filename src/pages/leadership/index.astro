---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrintTitle from '../../components/PrintTitle.astro';
import Stamp from '../../components/Stamp.astro';
import T from '../../components/T.astro';
import leadership from '../../data/leadership.json';
import stamps from '../../data/stamps.json';

const bi = (v: any) => (typeof v === 'string' ? { en: v, tr: v } : v);
const S = stamps as Record<string, any>;
---

<BaseLayout
  title="Leadership"
  path="/leadership"
  sheet="05"
  description="Community & leadership by İsmail Özyurt — founding president of KSBÜ Teknofest Club, Deneyap mentor, T3 Foundation scholar, and ÜNİDES project coordinator."
  descriptionTr="İsmail Özyurt’un topluluk ve liderlik rolleri — KSBÜ Teknofest Topluluğu kurucu başkanı, Deneyap mentoru, T3 Vakfı bursiyeri ve ÜNİDES proje koordinatörü."
>
  <section class="wrap sheet">
    <div class="sheet-row">
      <p class="k"><T en="Sheet 05 / 08 · Leadership" tr="Sayfa 05 / 08 · Liderlik" /></p>
      <p class="k"><T en={`${leadership.length} roles · 2024 → now`} tr={`${leadership.length} rol · 2024 → bugün`} /></p>
    </div>
    <div class="intro">
      <div class="intro-text">
        <PrintTitle en="Community, at a realistic scale." tr="Topluluk, gerçekçi bir ölçekte." size="clamp(52px, 7.6vw, 120px)" />
        <p class="lede intro-p">
          <T en="No inflated titles — just roles I actually hold and what they’ve produced." tr="Abartılı unvanlar yok — gerçekten üstlendiğim roller ve ortaya çıkardıkları işler." />
        </p>
      </div>
      <figure class="fig intro-fig">
        <span class="fig-block" style="background: var(--pink)" aria-hidden="true"></span>
        <img src="/images/teknofest.jpeg" width="2048" height="1536" alt="İsmail Özyurt on duty at TEKNOFEST, in front of a Bayraktar Akıncı" />
        <figcaption class="k"><T en="Fig. 02 — At TEKNOFEST" tr="Şekil 02 — TEKNOFEST’te" /></figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap sec" aria-label="Roles">
    <div class="roles">
      {leadership.map((item, i) => {
        const s = S[item.slug] ?? {};
        const points = (item.points ?? []).map(bi);
        return (
          <article class="card" id={item.slug}>
            <Stamp slug={item.slug} delay={0.4 + i * 0.25} />
            <div class="card-body">
              <p class="k"><T t={bi(item.period)} /></p>
              <h2 class="disp role"><T t={bi(item.role)} /></h2>
              <p class="org"><T t={bi(item.org)} /></p>
              <p class="muted summary"><T t={bi(item.summary)} /></p>
              {points.length > 0 && (
                <ul class="plain points">
                  {points.map((p) => (
                    <li><span class="dot" style={`background: ${s.ink}`} aria-hidden="true"></span><span><T t={p} /></span></li>
                  ))}
                </ul>
              )}
              {s.stat && (
                <p class="stat"><span class="disp stat-n">{s.stat}</span><span class="stat-l"><T t={s.statLabel} /></span></p>
              )}
              <a class="ulink" href={`/leadership/${item.slug}`}><T en="View details →" tr="Detayları gör →" /></a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .intro { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 32px 56px; }
  .intro-text { flex: 1 1 620px; min-width: 0; display: flex; flex-direction: column; gap: 26px; }
  .intro-p { max-width: 560px; font-size: 19px; }
  .intro-fig { flex: 0 1 420px; min-width: 260px; padding: 0 16px 16px 0; }
  .intro-fig .fig-block { left: 16px; top: 16px; right: 0; bottom: 34px; }
  .intro-fig img { aspect-ratio: 4 / 3; }

  .roles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(560px, 100%), 1fr));
    border-top: 6px solid var(--ink);
  }
  .card {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 32px;
    padding: 36px 8px 44px;
    border-bottom: 1.5px solid var(--ink);
    scroll-margin-top: 24px;
  }
  .card-body { flex: 1 1 260px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .role { font-size: clamp(28px, 2.8vw, 40px); line-height: 0.92; letter-spacing: -0.03em; }
  .org { font-weight: 700; font-size: 17px; }
  .summary { font-size: 16px; line-height: 1.6; }
  .points { margin-top: 4px; display: grid; gap: 10px; }
  .points li { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 8px; font-size: 15px; line-height: 1.55; }
  .dot { width: 12px; height: 12px; margin-top: 6px; border-radius: 50%; }
  .stat { margin-top: 6px; align-self: flex-start; display: flex; align-items: baseline; gap: 10px; padding: 10px 16px; border: 1.5px dashed var(--ink); }
  .stat-n { font-size: 40px; line-height: 1; }
  .stat-l { font-weight: 600; font-size: 14px; }
  .card .ulink { align-self: flex-start; }
</style>
