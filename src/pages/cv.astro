---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import site from '../data/site.json';
import cv from '../data/cv.json';
import experience from '../data/experience.json';
import leadership from '../data/leadership.json';

const bi = (v: any) => (typeof v === 'string' ? { en: v, tr: v } : v);
const corners = ['tl', 'tr', 'bl', 'br'];
---

<BaseLayout
  title="CV"
  path="/cv"
  sheet="07"
  description="CV of İsmail Özyurt — Computer Engineering student at Kütahya Health Sciences University and CTO at Ceviz Biyoteknoloji. Experience, education, skills, languages and certifications."
  descriptionTr="İsmail Özyurt’un özgeçmişi — Kütahya Sağlık Bilimleri Üniversitesi Bilgisayar Mühendisliği öğrencisi ve Ceviz Biyoteknoloji CTO’su. Deneyim, eğitim, beceriler, diller ve sertifikalar."
>
  <div class="cv-page" data-cv>
    <div class="wrap cv-bar no-print">
      <div class="cv-bar-text">
        <p class="k"><T en="Sheet 07 / 08 · CV" tr="Sayfa 07 / 08 · Özgeçmiş" /></p>
        <h1 class="disp cv-h"><T en="Full résumé, web & print" tr="Tam özgeçmiş, web ve baskı" /></h1>
      </div>
      <div class="cv-tools">
        <div class="seg" role="group" aria-label="Sheet view / Sayfa görünümü">
          <button type="button" data-marks="on" aria-pressed="true"><T en="Proof" tr="Prova" /></button>
          <button type="button" data-marks="off" aria-pressed="false"><T en="Press" tr="Baskı" /></button>
        </div>
        <button type="button" class="btn btn--ink print-btn" data-print>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V2h12v7"></path><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><path d="M6 14h12v8H6z"></path></svg>
          <T en="Print / Save as PDF" tr="Yazdır / PDF olarak kaydet" />
        </button>
      </div>
    </div>

    <div class="cv-stage">
      <article class="cv-sheet marks-on">
        <div class="marks" aria-hidden="true">
          {corners.map((c) => <span class={`crop crop-${c}`}></span>)}
          <div class="plates"><span style="background: var(--ink)"></span><span style="background: var(--blue)"></span><span style="background: var(--pink)"></span><span style="background: var(--lime)"></span><span style="background: #9A9CA0"></span></div>
        </div>

        <header class="cv-top">
          <div>
            <h2 class="disp cv-name" lang="tr">İsmail Özyurt</h2>
            <p class="cv-role"><T en="Third-year Computer Engineering student · Software Developer" tr="Üçüncü sınıf Bilgisayar Mühendisliği öğrencisi · Yazılım Geliştirici" /></p>
          </div>
          <ul class="plain cv-contact">
            <li lang="tr">Kütahya, Türkiye</li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><a href={site.linkedin}>{site.linkedinLabel}</a></li>
            <li><a href={site.github}>{site.githubLabel}</a> · <a href="https://ozyurt.dev">ozyurt.dev</a></li>
          </ul>
        </header>

        <section class="cv-sum">
          <h3 class="sh" style="--c: var(--ink)"><T en="Summary" tr="Özet" /></h3>
          <p><T t={bi(cv.summary)} /></p>
        </section>

        <div class="cvgrid">
          <div class="col">
            <section>
              <h3 class="sh" style="--c: var(--blue)"><T en="Experience" tr="Deneyim" /></h3>
              <div class="entries">
                {experience.map((e: any) => (
                  <div class="entry">
                    <div class="entry-head"><p class="entry-role"><T t={bi(e.role)} /></p><p class="entry-date"><T t={bi(e.period)} /></p></div>
                    <p class="entry-org"><T t={bi(e.org)} /></p>
                    <p class="entry-desc"><T t={bi(e.summary)} /></p>
                  </div>
                ))}
              </div>
            </section>
            <section>
              <h3 class="sh" style="--c: var(--pink)"><T en="Leadership & Community" tr="Liderlik & Topluluk" /></h3>
              <ul class="plain lead-list">
                {leadership.map((l: any) => (
                  <li><span><b><T t={bi(l.role)} /></b> · <T t={bi(l.org)} /></span><span class="muted"><T t={bi(l.period)} /></span></li>
                ))}
              </ul>
            </section>
          </div>

          <div class="col">
            <section>
              <h3 class="sh" style="--c: var(--c8)"><T en="Education" tr="Eğitim" /></h3>
              <div class="edu">
                {cv.education.map((e: any) => (
                  <div>
                    <p class="b"><T t={bi(e.degree)} /></p>
                    <p><T t={bi(e.school)} /></p>
                    <p class="muted"><T t={bi(e.period)} />{e.note?.en && <> · <T t={bi(e.note)} /></>}</p>
                  </div>
                ))}
              </div>
            </section>
            <section>
              <h3 class="sh" style="--c: var(--c7)"><T en="Technical Skills" tr="Teknik Beceriler" /></h3>
              <dl class="skills">
                {cv.skills.map((s: any) => (
                  <div><dt><T t={bi(s.group)} /></dt><dd><T t={bi(s.items)} /></dd></div>
                ))}
              </dl>
            </section>
            <section>
              <h3 class="sh" style="--c: var(--lilac)"><T en="Languages" tr="Diller" /></h3>
              <ul class="plain langs">
                {cv.languages.map((l: any) => <li><b><T t={bi(l.lang)} /></b><span><T t={bi(l.level)} /></span></li>)}
              </ul>
            </section>
            <section>
              <h3 class="sh" style="--c: var(--lime)"><T en="Certifications" tr="Sertifikalar" /></h3>
              <ul class="certs">
                {cv.certifications.map((c: any) => <li><T t={bi(c)} /></li>)}
              </ul>
            </section>
          </div>
        </div>

        <p class="slug" aria-hidden="true"><span>ozyurt.dev/cv</span><span><T en="Sheet 07 / 08" tr="Sayfa 07 / 08" /></span><span>A4 · 210 × 297 mm</span><span>Plates K · 2B50F0 · FF2E7E · D9FF4A</span></p>
      </article>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-cv]');
    if (!root) return;
    var sheet = root.querySelector('.cv-sheet');
    function marks(on) {
      sheet.classList.toggle('marks-on', on);
      root.querySelectorAll('[data-marks]').forEach(function (b) {
        b.setAttribute('aria-pressed', (b.getAttribute('data-marks') === 'on') === on ? 'true' : 'false');
      });
    }
    root.addEventListener('click', function (e) {
      var m = e.target.closest('[data-marks]');
      if (m) { marks(m.getAttribute('data-marks') === 'on'); return; }
      if (e.target.closest('[data-print]')) { marks(false); setTimeout(function () { window.print(); }, 60); }
    });
  })();
</script>

<style>
  .cv-bar { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 24px; max-width: 1000px; padding-top: clamp(28px, 4vw, 48px); padding-bottom: 24px; }
  .cv-bar-text { display: flex; flex-direction: column; gap: 10px; }
  .cv-h { font-size: clamp(44px, 5.4vw, 80px); line-height: 0.86; letter-spacing: -0.045em; }
  .cv-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .seg { display: flex; gap: 3px; padding: 3px; border: 1.5px solid var(--ink); border-radius: 999px; background: var(--paper); }
  .seg button { min-height: 44px; padding: 0 16px; border: 0; border-radius: 999px; background: transparent; color: var(--ink); font: 600 14px/1 var(--font-body); cursor: pointer; }
  .seg button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .print-btn { min-height: 50px; padding: 0 22px; }

  .cv-stage { padding: 0 clamp(0px, 3vw, 48px) clamp(48px, 6vw, 88px); }
  .cv-sheet {
    position: relative;
    max-width: 920px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 64px) clamp(20px, 5vw, 64px);
    background-color: #FFFFFF;
    background-image: url(/textures/grain.png);
    background-size: 256px 256px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.28);
    font-size: 14px;
    line-height: 1.5;
  }
  .marks { display: none; }
  .marks-on .marks { display: block; }
  /* Kesim işaretleri: sol üst köşe çizilir, diğerleri aynalanır */
  .crop { position: absolute; width: 46px; height: 46px; }
  .crop::before, .crop::after { content: ''; position: absolute; background: var(--ink); }
  .crop::before { left: 0; top: 26px; width: 20px; height: 1px; }
  .crop::after { left: 26px; top: 0; width: 1px; height: 20px; }
  .crop-tl { left: 0; top: 0; }
  .crop-tr { right: 0; top: 0; transform: scaleX(-1); }
  .crop-bl { left: 0; bottom: 0; transform: scaleY(-1); }
  .crop-br { right: 0; bottom: 0; transform: scale(-1, -1); }
  .plates { position: absolute; left: 50%; top: 8px; transform: translateX(-50%); display: flex; border: 1px solid var(--ink); }
  .plates span { width: 18px; height: 10px; }
  .slug { display: none; }
  .marks-on .slug { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; margin-top: 28px; padding-top: 10px; border-top: 1px solid var(--rule); color: var(--ink-3); font-weight: 600; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; }

  .cv-top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 24px; padding-bottom: 20px; border-bottom: 6px solid var(--ink); }
  .cv-name { font-size: clamp(40px, 6vw, 68px); line-height: 0.86; letter-spacing: -0.045em; }
  .cv-role { margin-top: 10px; font-weight: 600; font-size: 16px; }
  .cv-contact { display: grid; gap: 2px; font-size: 13.5px; text-align: right; }
  .cv-contact a { text-decoration: none; }
  .cv-contact a:hover { text-decoration: underline; }

  .sh { margin: 0 0 12px; padding-bottom: 6px; border-bottom: 3px solid var(--c); font-family: var(--font-display); font-weight: 900; font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase; }
  .cv-sum { padding: 22px 0 6px; }
  .cv-sum p { font-size: 15px; line-height: 1.6; }
  .cvgrid { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); gap: 36px; padding-top: 20px; }
  .col { min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .entries { display: flex; flex-direction: column; gap: 16px; }
  .entry { display: flex; flex-direction: column; gap: 4px; }
  .entry-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 12px; }
  .entry-role { font-weight: 700; font-size: 15px; }
  .entry-date { font-weight: 600; font-size: 13px; color: var(--ink-2); }
  .entry-org { font-weight: 600; font-size: 14px; color: var(--blue); }
  .entry-desc { font-size: 13.5px; color: var(--ink-2); }
  .lead-list { display: grid; gap: 8px; font-size: 14px; }
  .lead-list li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 12px; }
  .edu { display: grid; gap: 12px; font-size: 14px; }
  .b { font-weight: 700; }
  .skills { display: grid; gap: 10px; font-size: 13.5px; }
  .skills dt { font-weight: 700; }
  .langs { display: grid; gap: 6px; font-size: 14px; }
  .langs li { display: flex; justify-content: space-between; gap: 12px; }
  .certs { margin: 0; padding-left: 18px; display: grid; gap: 5px; font-size: 13.5px; line-height: 1.45; }

  @media (max-width: 760px) {
    .cvgrid { grid-template-columns: minmax(0, 1fr); }
    .cv-contact { text-align: left; }
  }
  @media print {
    :global(.hdr), :global(.ftr), :global(.skip-link), .no-print { display: none !important; }
    :global(body) { background: #FFFFFF !important; }
    .cv-stage { padding: 0; }
    .cv-sheet { max-width: none; margin: 0; padding: 0; box-shadow: none; background: #FFFFFF; }
    .marks, .slug { display: none !important; }
    @page { size: A4; margin: 14mm; }
  }
</style>
