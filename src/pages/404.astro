---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrintTitle from '../components/PrintTitle.astro';
import T from '../components/T.astro';
---

<BaseLayout path="/404" title="Not found">
  <section class="wrap sheet nf">
    <div class="sheet-row">
      <p class="k"><T en="Sheet 404 · Misprint" tr="Sayfa 404 · Baskı hatası" /></p>
      <p class="k"><T en="Not in this edition" tr="Bu baskıda yok" /></p>
    </div>
    <p class="disp nf-code" aria-hidden="true">404</p>
    <PrintTitle en="This page took a different path." tr="Bu sayfa başka bir yola saptı." size="clamp(44px, 6.6vw, 104px)" />
    <p class="lede nf-p">
      <T en="The page you’re after doesn’t exist — or moved. Everything else is still one click away."
         tr="Aradığın sayfa yok — ya da taşındı. Geri kalan her şey bir tık uzağında." />
    </p>
    <div class="btns">
      <a class="btn btn--ink" href="/"><T en="Back home" tr="Ana sayfaya dön" /></a>
      <a class="btn" href="/projects"><T en="See projects" tr="Projelere bak" /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { display: flex; flex-direction: column; gap: 24px; padding-bottom: clamp(64px, 8vw, 120px); }
  .nf-code {
    font-size: clamp(120px, 24vw, 340px);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
  }
  .nf-p { max-width: 560px; }
</style>
