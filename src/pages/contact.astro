---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrintTitle from '../components/PrintTitle.astro';
import T from '../components/T.astro';
import site from '../data/site.json';

const channels = [
  { k: { en: 'Email', tr: 'E-posta' }, v: site.email, href: `mailto:${site.email}` },
  { k: { en: 'LinkedIn', tr: 'LinkedIn' }, v: site.linkedinLabel, href: site.linkedin },
  { k: { en: 'GitHub', tr: 'GitHub' }, v: site.githubLabel, href: site.github },
  { k: { en: 'Ceviz Biyoteknoloji', tr: 'Ceviz Biyoteknoloji' }, v: site.cevizSiteLabel, href: site.cevizSite },
  { k: { en: 'Location', tr: 'Konum' }, v: 'Kütahya, Türkiye' },
];
---

<BaseLayout
  title="Contact"
  path="/contact"
  sheet="08"
  footer="name"
  description="Get in touch with İsmail Özyurt — email, LinkedIn, or the contact form."
  descriptionTr="İsmail Özyurt’a ulaş — e-posta, LinkedIn ya da iletişim formu."
>
  <section class="wrap sheet">
    <div class="sheet-row">
      <p class="k"><T en="Sheet 08 / 08 · Contact" tr="Sayfa 08 / 08 · İletişim" /></p>
      <p class="k"><span data-lang="en">Replies come from {site.email}</span><span data-lang="tr" lang="tr">Yanıtlar <span lang="en">{site.email}</span> adresinden gelir</span></p>
    </div>
    <div class="intro">
      <PrintTitle en="Let’s talk." tr="Konuşalım." size="clamp(64px, 11vw, 176px)" />
      <p class="lede intro-p">
        <T
          en="Building something, hiring, or just curious? Send a message with the form, or reach me directly through the channels here."
          tr="Bir şey mi geliştiriyorsun, işe mi alıyorsun, yoksa sadece merak mı ettin? Formdan mesaj bırakabilir ya da buradaki kanallardan doğrudan ulaşabilirsin."
        />
      </p>
    </div>
  </section>

  <section class="wrap contact">
    <div class="chans">
      <p class="k chans-k"><T en="Direct" tr="Doğrudan" /></p>
      {channels.map((c) => c.href ? (
        <a class="chan" href={c.href} rel={c.href.startsWith('http') ? 'me noopener' : undefined}>
          <span class="chan-text"><span class="k"><T t={c.k} /></span><span class="chan-v"><Fragment set:html={c.v.replace(/\//g, '/<wbr>')} /></span></span>
          <span class="chan-arr" aria-hidden="true">↗</span>
        </a>
      ) : (
        <div class="chan">
          <span class="chan-text"><span class="k"><T t={c.k} /></span><span class="chan-v" lang="tr">{c.v}</span></span>
        </div>
      ))}
    </div>

    <form id="contact-form" class="note" aria-labelledby="note-title" novalidate>
      <div class="static" aria-hidden="true"></div>
      <div class="note-head">
        <h2 id="note-title" class="disp note-title"><T en="Send a note" tr="Not gönder" /></h2>
        <div class="signal" aria-hidden="true">
          <p class="k"><T en="Signal" tr="Sinyal" /></p>
          <div class="bars">{[0, 1, 2, 3, 4].map((i) => <span style={`height: ${8 + i * 5}px`}></span>)}</div>
        </div>
      </div>

      <div class="row2">
        <div class="field">
          <label for="c-name"><T en="Name" tr="Ad soyad" /></label>
          <input id="c-name" class="fld" name="name" type="text" required autocomplete="name" maxlength="120" data-ph-en="Your name" data-ph-tr="Adın" />
        </div>
        <div class="field">
          <label for="c-email"><T en="Email" tr="E-posta" /></label>
          <input id="c-email" class="fld" name="email" type="email" required autocomplete="email" maxlength="254" data-ph-en="mail@example.com" data-ph-tr="mail@ornek.com" />
        </div>
      </div>
      <div class="field">
        <label for="c-subject"><T en="Subject" tr="Konu" /> <span class="opt"><T en="(optional)" tr="(isteğe bağlı)" /></span></label>
        <input id="c-subject" class="fld" name="subject" type="text" maxlength="160" data-ph-en="What’s it about?" data-ph-tr="Ne hakkında?" />
      </div>
      <div class="field">
        <label for="c-message"><T en="Message" tr="Mesaj" /></label>
        <textarea id="c-message" class="fld" name="message" rows="6" required maxlength="5000" data-ph-en="Hi İsmail, …" data-ph-tr="Merhaba İsmail, …"></textarea>
      </div>

      <!-- Honeypot: botlar için, insanlar görmez -->
      <div class="hp" aria-hidden="true">
        <label for="c-company">Company</label>
        <input id="c-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="note-foot">
        <p id="form-status" class="status" role="status" aria-live="polite"></p>
        <button id="contact-submit" class="send" type="submit"><span class="send-label"><T en="Send message" tr="Mesajı gönder" /></span></button>
      </div>
      <noscript><p class="status"><T en={`The form needs JavaScript. You can write to ${site.email} directly.`} tr={`Form için JavaScript gerekiyor. Doğrudan ${site.email} adresine yazabilirsin.`} /></p></noscript>
    </form>
  </section>
</BaseLayout>

<script is:inline define:vars={{ email: site.email }}>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;
    var status = document.getElementById('form-status');
    var btn = document.getElementById('contact-submit');
    var label = btn.querySelector('.send-label');
    var bars = form.querySelectorAll('.bars span');
    var noise = form.querySelector('.static');
    var f = {
      name: form.querySelector('#c-name'),
      email: form.querySelector('#c-email'),
      subject: form.querySelector('#c-subject'),
      message: form.querySelector('#c-message'),
    };
    var EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    var COPY = {
      idle: { en: 'Fill in the fields to clear the signal.', tr: 'Sinyali netleştirmek için alanları doldur.' },
      more: { en: ' more to go.', tr: ' alan kaldı.' },
      ready: { en: 'Signal clear. Ready to send.', tr: 'Sinyal net. Göndermeye hazır.' },
      sending: { en: 'Sending…', tr: 'Gönderiliyor…' },
      success: { en: 'Message sent. I’ll get back to you soon.', tr: 'Mesajın gönderildi. En kısa sürede dönüş yapacağım.' },
      error: { en: 'Something went wrong. You can write to me directly: ', tr: 'Bir şeyler ters gitti. Doğrudan yazmak istersen: ' },
      invalid: { en: 'Please fill in your name, a valid email address, and a message.', tr: 'Lütfen adını, geçerli bir e-posta adresini ve mesajını yaz.' },
      send: { en: 'Send message', tr: 'Mesajı gönder' },
    };
    var sticky = null; // success / error / invalid mesajı, kullanıcı yeniden yazana kadar kalır
    var sending = false;

    function lang() { return document.documentElement.getAttribute('data-lang') === 'tr' ? 'tr' : 'en'; }

    function placeholders() {
      var l = lang();
      form.querySelectorAll('[data-ph-' + l + ']').forEach(function (inp) {
        inp.setAttribute('placeholder', inp.getAttribute('data-ph-' + l) || '');
      });
    }

    function state() {
      var ok = {
        name: f.name.value.trim().length > 1,
        email: EMAIL.test(f.email.value.trim()),
        subject: f.subject.value.trim().length > 2,
        message: f.message.value.trim().length > 0,
      };
      var required = ['name', 'email', 'message'].filter(function (k) { return ok[k]; }).length;
      var all = required + (ok.subject ? 1 : 0);
      return { ok: ok, required: required, ready: required === 3, lit: all + (required === 3 ? 1 : 0) };
    }

    function render() {
      var s = state();
      var l = lang();
      bars.forEach(function (b, i) { b.classList.toggle('on', i < s.lit); });
      noise.style.opacity = (0.06 + (3 - s.required) * 0.1).toFixed(2);
      btn.classList.toggle('ready', s.ready);
      if (sending) { status.textContent = COPY.sending[l]; status.className = 'status'; return; }
      if (sticky === 'error') {
        status.className = 'status is-error';
        status.innerHTML = COPY.error[l] + '<a href="mailto:' + email + '">' + email + '</a>';
        return;
      }
      if (sticky) { status.className = 'status ' + (sticky === 'success' ? 'is-success' : 'is-error'); status.textContent = COPY[sticky][l]; return; }
      status.className = 'status' + (s.ready ? ' is-ready' : '');
      if (s.ready) status.textContent = COPY.ready[l];
      else if (s.required === 0 && !s.ok.subject) status.textContent = COPY.idle[l];
      else status.textContent = (3 - s.required) + COPY.more[l];
    }

    form.addEventListener('input', function () { sticky = null; render(); });
    document.addEventListener('langchange', function () { placeholders(); render(); });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (sending) return;
      var fd = new FormData(form);
      var data = {
        name: String(fd.get('name') || '').trim(),
        email: String(fd.get('email') || '').trim(),
        subject: String(fd.get('subject') || '').trim(),
        message: String(fd.get('message') || '').trim(),
        company: String(fd.get('company') || ''),
      };
      if (!data.name || !data.message || !EMAIL.test(data.email)) { sticky = 'invalid'; render(); return; }

      sending = true;
      btn.disabled = true;
      render();
      fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      })
        .then(function (res) {
          return res.json().catch(function () { return {}; }).then(function (body) { return res.ok && body.success !== false; });
        })
        .then(function (ok) { if (ok) form.reset(); sticky = ok ? 'success' : 'error'; })
        .catch(function () { sticky = 'error'; })
        .finally(function () { sending = false; btn.disabled = false; render(); });
    });

    placeholders();
    render();
  })();
</script>

<style>
  .intro { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 56px; }
  .intro-p { flex: 0 1 460px; font-size: 19px; }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 32px;
    padding-bottom: clamp(64px, 7vw, 104px);
  }

  .chans { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; border-top: 6px solid var(--ink); }
  .chans-k { padding: 16px 0 10px; }
  .chan {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 76px;
    padding: 12px 10px;
    border-bottom: 1.5px solid var(--ink);
    text-decoration: none;
  }
  a.chan:hover { background: var(--card); color: var(--ink); }
  .chan-text { min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .chan-v { font-weight: 700; font-size: 20px; line-height: 1.3; overflow-wrap: anywhere; }
  .chan-arr { font-size: 22px; transition: transform 0.3s; }
  a.chan:hover .chan-arr { transform: translate(3px, -3px); }

  .note {
    flex: 1.4 1 520px;
    min-width: 0;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(22px, 3vw, 36px);
    border: 1px solid var(--night-line);
    border-radius: 28px;
    background: var(--night);
    color: var(--night-text);
  }
  .note > * { position: relative; }
  .note > .static { position: absolute; }
  .static {
    inset: 0;
    background-image: url(/textures/static.png);
    background-size: 256px 256px;
    mix-blend-mode: screen;
    opacity: 0.36;
    pointer-events: none;
    transition: opacity 0.4s;
    animation: st 0.42s steps(5) infinite;
  }
  @keyframes st {
    0% { background-position: 0 0; }
    20% { background-position: -61px 37px; }
    40% { background-position: 83px -29px; }
    60% { background-position: -17px -91px; }
    80% { background-position: 113px 71px; }
    100% { background-position: 0 0; }
  }
  .note-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .note-title { font-size: clamp(30px, 3vw, 44px); line-height: 0.9; }
  .signal { display: flex; align-items: center; gap: 12px; }
  .signal .k { color: var(--night-dim); }
  .bars { display: flex; align-items: flex-end; gap: 4px; height: 28px; }
  .bars span { width: 7px; border-radius: 2px; background: var(--night-line); transition: background 0.3s; }
  .bars span.on { background: var(--lime); }

  .row2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 14px; }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field label { font-weight: 600; font-size: 14px; }
  .opt { font-weight: 500; color: var(--night-dim); }
  .fld {
    width: 100%;
    min-height: 52px;
    padding: 14px 16px;
    border: 1px solid var(--night-field);
    border-radius: 14px;
    background: var(--night-2);
    color: var(--night-text);
    font: 500 16px/1.4 var(--font-body);
  }
  textarea.fld { resize: vertical; min-height: 150px; }
  .fld::placeholder { color: #8A93A3; }
  .fld:focus { outline: 3px solid var(--lime); outline-offset: 2px; border-color: var(--lime); }
  .hp { position: absolute !important; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .note-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .status { margin: 0; flex: 1 1 240px; font-size: 14px; color: var(--night-muted); }
  .status.is-ready, .status.is-success { color: var(--lime); }
  .status.is-error { color: #FF9C8A; }
  .status a { color: var(--night-text); }
  .send {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 26px;
    border: 0;
    border-radius: 999px;
    background: var(--night-line);
    color: var(--night-text);
    font: 700 16px/1 var(--font-body);
    cursor: pointer;
    transition: background 0.3s, color 0.3s;
  }
  .send.ready { background: var(--lime); color: var(--night-2); }
  .send:disabled { opacity: 0.7; cursor: progress; }
  .send:focus-visible { outline-color: var(--lime); }
</style>
