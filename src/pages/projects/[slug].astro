---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrintTitle from '../../components/PrintTitle.astro';
import Gallery from '../../components/Gallery.astro';
import T from '../../components/T.astro';
import projects from '../../data/projects.json';
import meta from '../../data/project-meta.json';

export function getStaticPaths() {
  // "hidden" projeler sayfa üretmez (eski adres public/_redirects ile /projects'e yönlenir)
  const list = (projects as any[]).filter((p) => !p.hidden);
  return list.map((p, i) => ({
    params: { slug: p.slug },
    props: { project: p, n: i + 1, next: list[(i + 1) % list.length] },
  }));
}

const { project, n, next } = Astro.props as any;
const bi = (v: any) => (typeof v === 'string' ? { en: v, tr: v } : v);
const title = bi(project.title);
const m = (meta as Record<string, any>)[project.slug] ?? {};
const points = (project.points ?? []).map(bi);
---

<BaseLayout
  path={`/projects/${project.slug}`}
  title={title.en}
  sheet="03"
  description={bi(project.summary).en}
  descriptionTr={bi(project.summary).tr}
>
  <section class="wrap sheet">
    <div class="sheet-row">
      <a class="back k" href="/projects">← <T en="Sheet 03 · Projects" tr="Sayfa 03 · Projeler" /></a>
      <p class="k"><T en={`Project ${String(n).padStart(2, '0')}`} tr={`Proje ${String(n).padStart(2, '0')}`} /> · <T t={bi(project.period)} /></p>
    </div>
    <div class="detail-intro">
      <div class="detail-intro-text">
        <p class="award"><span class="swatch" style={`background: ${m.c ?? 'var(--c6)'}`} aria-hidden="true"></span><T t={bi(project.award)} /></p>
        <PrintTitle en={title.en} tr={title.tr} size="clamp(44px, 6.4vw, 104px)" />
      </div>
    </div>
  </section>

  <section class="wrap sec">
    <div class="detail">
      <div class="detail-main">
        <p class="detail-summary"><T t={bi(project.summary)} /></p>
        {points.length > 0 && (
          <ul class="plain bullets" style={`--dot: ${m.c ?? 'var(--ink)'}`}>
            {points.map((p: any) => <li><span><T t={p} /></span></li>)}
          </ul>
        )}
        {project.mentor && (
          <p class="muted">
            <T en="Mentored by " tr="Staj boyunca " /><a href={project.mentor.url} rel="noopener">{project.mentor.name}</a><T en=" throughout the internship." tr="’ın mentorluğunda çalıştım." />
          </p>
        )}
        <div class="btns">
          <a class="btn btn--ink" href={`https://ismail.ozyurt.dev/${project.slug}`}><T en="Screens & stack on ismail.ozyurt.dev" tr="Ekranlar ve teknolojiler ismail.ozyurt.dev’de" /> ↗</a>
          {project.repo && <a class="btn" href={project.repo} rel="noopener"><T en="View repo" tr="Repoyu gör" /> ↗</a>}
          {project.report && <a class="btn" href={project.report.href} download>↓ <T t={bi(project.report.label)} /></a>}
        </div>
        {project.gallery?.length > 0 && <Gallery images={project.gallery} phone />}
      </div>
      <dl class="facts">
        <div><dt class="k"><T en="Period" tr="Dönem" /></dt><dd><T t={bi(project.period)} /></dd></div>
        <div><dt class="k"><T en="Context" tr="Bağlam" /></dt><dd><T t={bi(project.award)} /></dd></div>
        {project.tags?.length > 0 && (
          <div><dt class="k"><T en="Stack & focus" tr="Teknoloji & odak" /></dt><dd class="chips">{project.tags.map((t: any) => <span class="chip"><T t={bi(t)} /></span>)}</dd></div>
        )}
      </dl>
    </div>
  </section>

  <section class="wrap sec">
    <div class="next-row">
      <a class="btn" href="/projects">← <T en="All projects" tr="Tüm projeler" /></a>
      <a class="ulink" href={`/projects/${next.slug}`}><T en="Next:" tr="Sıradaki:" />&nbsp;<T t={bi(next.title)} /> →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .award { display: inline-flex; align-items: center; gap: 12px; font-weight: 700; font-size: 16px; color: var(--blue); }
  .swatch { flex: none; width: 28px; height: 28px; border: 3px solid var(--ink); border-radius: 50%; }
  .facts .chips { padding-top: 4px; }
</style>
