---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrintTitle from '../components/PrintTitle.astro';
import T from '../components/T.astro';
import portfolio from '../data/portfolio.json';

const colors = ['var(--lime)', 'var(--c11)', 'var(--c9)', 'var(--c7)', 'var(--c5)', 'var(--c10)'];
const tilts = [-1.4, 1, -0.6, 0.8, -1, 0.5];

// Adresten türetilen sahte barkod (her site için sabit, kendine özgü)
function barcode(s: string) {
  let h = 2166136261;
  const stops: string[] = [];
  let x = 0;
  for (let i = 0; i < 36; i++) {
    h ^= s.charCodeAt(i % s.length) + i * 7;
    h = Math.imul(h, 16777619) >>> 0;
    const bar = 1 + (h % 3);
    const gap = 1 + ((h >>> 3) % 3);
    stops.push(`#0B0C10 ${x}px ${x + bar}px`, `transparent ${x + bar}px ${x + bar + gap}px`);
    x += bar + gap;
  }
  return `linear-gradient(90deg, ${stops.join(', ')}) left center / ${x}px 100% no-repeat`;
}

const sites = portfolio.map((s, i) => ({
  ...s,
  n: String(i + 1).padStart(2, '0'),
  c: colors[i % colors.length],
  tilt: tilts[i % tilts.length],
  delay: (0.25 + i * 0.22).toFixed(2),
  code: barcode(s.urlLabel),
  track: `WEB-${String(i + 1).padStart(2, '0')}`,
}));
---

<BaseLayout
  title="Portfolio"
  path="/portfolio"
  sheet="04"
  description="Websites designed and coded by İsmail Özyurt — the Ceviz Biyoteknoloji brand site, and sites for local businesses in Kütahya. Each one, its purpose, and what it's built with."
  descriptionTr="İsmail Özyurt’un tasarlayıp kodladığı web siteleri — Ceviz Biyoteknoloji marka sitesi ve Kütahya’daki yerel işletmeler için siteler. Her biri, amacı ve hangi teknolojiyle yapıldığı."
>
  <section class="wrap sheet">
    <div class="sheet-row">
      <p class="k"><T en="Sheet 04 / 08 · Portfolio" tr="Sayfa 04 / 08 · Portfolyo" /></p>
      <p class="k"><T en={`${sites.length} sites · shipped to the open web`} tr={`${sites.length} site · açık web’de yayında`} /></p>
    </div>
    <div class="intro">
      <PrintTitle en="Websites I’ve built." tr="Yaptığım web siteleri." size="clamp(52px, 8vw, 128px)" class="intro-h" />
      <p class="lede intro-p">
        <T en="A few sites I designed and coded — for my own company and for local businesses in Kütahya. Each one below: where it points, what it’s for, and what it’s built with."
           tr="Tasarlayıp kodladığım birkaç site — kendi şirketim ve Kütahya’daki yerel işletmeler için. Aşağıda her biri: nereye gittiği, ne işe yaradığı ve hangi teknolojiyle yapıldığı." />
      </p>
    </div>
  </section>

  <section class="belt" aria-label="Shipments">
    <div class="wrap labels">
      {sites.map((s) => (
        <div class="arrive" style={`animation-delay: ${s.delay}s`}>
          <div style={`transform: rotate(${s.tilt}deg)`}>
            <article class="lbl">
              <div class="lbl-top" style={`background: ${s.c}`}>
                <h2 class="disp lbl-title" lang="tr">{s.title}</h2>
                <span class="disp lbl-n">{s.n}</span>
              </div>
              <div class="lbl-cell">
                <p class="k"><T en="Shipped to" tr="Yayın adresi" /></p>
                <a class="lbl-url" href={s.url}><Fragment set:html={s.urlLabel.replace(/\./g, '.<wbr>')} /> ↗</a>
              </div>
              <div class="lbl-cell lbl-contents">
                <p class="k"><T en="Contents" tr="İçerik" /></p>
                <p class="muted lbl-p"><T t={s.purpose} /></p>
              </div>
              <div class="lbl-split">
                <div><p class="k"><T en="Built with" tr="Teknoloji" /></p><p class="chips lbl-chips">{s.tech.map((t) => <span class="chip">{t}</span>)}</p></div>
                <div><p class="k"><T en="Site language" tr="Site dili" /></p><p class="lbl-lang"><T t={s.lang} /></p></div>
              </div>
              <div class="lbl-code">
                <span class="code" style={`background: ${s.code}`} aria-hidden="true"></span>
                <span class="cond track">{s.track}</span>
                <span class="laser" aria-hidden="true"></span>
              </div>
            </article>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap sec manifest-sec" aria-labelledby="manifest">
    <div class="manifest-head">
      <h2 id="manifest" class="disp manifest-h"><T en="Manifest" tr="Sevk listesi" /></h2>
      <a class="ulink" href="/projects/ceviz"><T en="The Ceviz sites in depth: case study →" tr="Ceviz siteleri ayrıntılı: inceleme →" /></a>
    </div>
    <div class="table-scroll">
      <table class="manifest">
        <thead>
          <tr>
            <th class="k"><T en="No." tr="No." /></th>
            <th class="k"><T en="Site" tr="Site" /></th>
            <th class="k"><T en="Address" tr="Adres" /></th>
            <th class="k"><T en="Built with" tr="Teknoloji" /></th>
            <th class="k"><T en="Language" tr="Dil" /></th>
          </tr>
        </thead>
        <tbody>
          {sites.map((s) => (
            <tr>
              <td class="cond m-n">{s.n}</td>
              <td class="m-title" lang="tr">{s.title}</td>
              <td><a href={s.url}>{s.urlLabel}</a></td>
              <td>{s.tech.join(', ')}</td>
              <td><T t={s.lang} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 28px 56px; }
  .intro :global(.intro-h) { flex: 1 1 620px; }
  .intro-p { flex: 1 1 360px; max-width: 480px; font-size: 18px; }

  .belt {
    padding-block: clamp(36px, 4vw, 56px);
    border-block: 10px solid #2E3038;
    background-color: #1B1C21;
    background-image: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.05) 0 2px, transparent 2px 46px);
    animation: beltmove 1.5s linear infinite;
  }
  .belt:hover { animation-play-state: paused; }
  @keyframes beltmove { from { background-position: 0 0; } to { background-position: -46px 0; } }
  .labels { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 28px; }
  .arrive { animation: arrive 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  @keyframes arrive { from { transform: translateX(120vw); } to { transform: translateX(0); } }

  .lbl {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    background: var(--card);
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.4);
    transition: transform 0.3s var(--ease), box-shadow 0.3s;
  }
  .lbl:hover, .lbl:focus-within { transform: translateY(-10px); box-shadow: 0 34px 50px rgba(0, 0, 0, 0.5); }
  .lbl-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 18px; border-bottom: 1.5px solid var(--ink); }
  .lbl-title { font-size: 24px; line-height: 0.95; letter-spacing: -0.02em; }
  .lbl-n { font-size: 30px; line-height: 1; }
  .lbl-cell { padding: 16px 18px; border-bottom: 1.5px solid var(--ink); }
  .lbl-url {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(19px, 1.6vw, 24px);
    letter-spacing: -0.02em;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .lbl-contents { min-height: 150px; }
  .lbl-p { margin-top: 8px; font-size: 16px; }
  .lbl-split { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1.5px solid var(--ink); }
  .lbl-split > div { padding: 12px 18px; }
  .lbl-split > div:first-child { border-right: 1.5px solid var(--ink); }
  .lbl-chips { margin-top: 6px; }
  .lbl-chips .chip { min-height: 26px; padding: 0 10px; font-size: 12px; font-weight: 700; }
  .lbl-lang { margin-top: 6px; font-weight: 700; font-size: 15px; }
  .lbl-code { position: relative; display: flex; align-items: center; gap: 14px; padding: 14px 18px; }
  .code { flex: 1; height: 44px; }
  .track { font-size: 16px; letter-spacing: 0.06em; }
  .laser { position: absolute; left: 10px; right: 10px; top: 14px; height: 2px; background: var(--pink); box-shadow: 0 0 10px var(--pink); opacity: 0; }
  .lbl:hover .laser, .lbl:focus-within .laser { opacity: 1; animation: sweep 0.9s ease-in-out infinite alternate; }
  @keyframes sweep { from { transform: translateY(0); } to { transform: translateY(44px); } }

  .manifest-sec { padding-top: clamp(56px, 6vw, 88px); }
  .manifest-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 24px;
    padding: 18px 0;
    border-top: 6px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
  }
  .manifest-h { font-size: clamp(36px, 4.2vw, 60px); line-height: 0.88; letter-spacing: -0.04em; }
  .table-scroll { overflow-x: auto; }
  .manifest { width: 100%; min-width: 640px; border-collapse: collapse; font-size: 15px; text-align: left; }
  .manifest th { padding: 14px 8px; border-bottom: 1.5px solid var(--ink); font-weight: 600; }
  .manifest td { padding: 14px 8px; border-bottom: 1px solid var(--rule); vertical-align: middle; }
  .manifest td a { display: inline-flex; align-items: center; min-height: 32px; }
  .m-n { width: 64px; font-size: 22px; }
  .m-title { font-weight: 700; }
</style>
