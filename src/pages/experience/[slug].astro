---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrintTitle from '../../components/PrintTitle.astro';
import Gallery from '../../components/Gallery.astro';
import T from '../../components/T.astro';
import experience from '../../data/experience.json';

export function getStaticPaths() {
  const withSlug = experience.filter((e: any) => e.slug && !e.hidden);
  return withSlug.map((item: any, i: number) => ({
    params: { slug: item.slug },
    props: { item, next: withSlug[(i + 1) % withSlug.length] },
  }));
}

const { item, next } = Astro.props as any;
const bi = (v: any) => (typeof v === 'string' ? { en: v, tr: v } : v);
const role = bi(item.role);
const points = (item.points ?? []).map(bi);
const color: Record<string, string> = { 'ml-research': 'var(--c5)', gurok: 'var(--c8)', gural: 'var(--c9)', salerno: 'var(--c11)' };
---

<BaseLayout
  path={`/experience/${item.slug}`}
  title={`${role.en} — ${bi(item.org).en}`}
  sheet="02"
  description={bi(item.summary).en}
  descriptionTr={bi(item.summary).tr}
>
  <section class="wrap sheet">
    <div class="sheet-row">
      <a class="back k" href="/experience">← <T en="Sheet 02 · Experience" tr="Sayfa 02 · Deneyim" /></a>
      <p class="k"><T t={bi(item.kind)} /></p>
    </div>
    <div class="detail-intro">
      <div class="detail-intro-text">
        <p class="cond period" style={`--c: ${color[item.id] ?? 'var(--c6)'}`}><span class="swatch" aria-hidden="true"></span><T t={bi(item.period)} /></p>
        <PrintTitle en={role.en} tr={role.tr} size="clamp(44px, 6.4vw, 104px)" />
        <p class="detail-sub"><T t={bi(item.org)} /></p>
      </div>
    </div>
  </section>

  <section class="wrap sec">
    <div class="detail">
      <div class="detail-main">
        <p class="detail-summary"><T t={bi(item.summary)} /></p>
        {points.length > 0 && (
          <ol class="plain outcome-list">
            {points.map((p: any, i: number) => (
              <li><span class="cond outcome-n">{String(i + 1).padStart(2, '0')}</span><span><T t={p} /></span></li>
            ))}
          </ol>
        )}
        {item.report && (
          <a class="btn btn--ink report" href={item.report.href} download>↓ <T t={bi(item.report.label)} /></a>
        )}
        {item.gallery?.length > 0 && <Gallery images={item.gallery} />}
      </div>
      <dl class="facts">
        <div><dt class="k"><T en="Role" tr="Rol" /></dt><dd><T t={role} /></dd></div>
        <div><dt class="k"><T en="Organization" tr="Kurum" /></dt><dd><T t={bi(item.org)} /></dd></div>
        <div><dt class="k"><T en="Period" tr="Dönem" /></dt><dd><T t={bi(item.period)} /></dd></div>
        {item.tags?.length > 0 && (
          <div><dt class="k"><T en="Stack & focus" tr="Teknoloji & odak" /></dt><dd class="chips">{item.tags.map((t: string) => <span class="chip">{t}</span>)}</dd></div>
        )}
      </dl>
    </div>
  </section>

  <section class="wrap sec">
    <div class="next-row">
      <a class="btn" href="/experience">← <T en="Full timeline" tr="Tüm zaman çizelgesi" /></a>
      <a class="ulink" href={`/experience/${next.slug}`}><T en="Next:" tr="Sıradaki:" />&nbsp;<T t={bi(next.org)} /> →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .period { display: inline-flex; align-items: center; gap: 12px; font-size: 22px; line-height: 1; }
  .swatch { width: 28px; height: 28px; border: 3px solid var(--ink); border-radius: 50%; background: var(--c); }
  .outcome-list { display: grid; gap: 12px; }
  .outcome-list li { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 10px; font-size: 17px; line-height: 1.6; }
  .outcome-n { font-size: 19px; color: var(--ink-2); }
  .report { align-self: flex-start; }
  .facts .chips { padding-top: 4px; }
</style>
