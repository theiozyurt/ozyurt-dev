---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrintTitle from '../../components/PrintTitle.astro';
import T from '../../components/T.astro';
import experience from '../../data/experience.json';

const bi = (v: any) => (typeof v === 'string' ? { en: v, tr: v } : v);
const color: Record<string, string> = {
  ceviz: 'var(--lime)',
  'ml-research': 'var(--c5)',
  gurok: 'var(--c8)',
  gural: 'var(--c9)',
  salerno: 'var(--c11)',
};
const now = new Set(['ceviz', 'ml-research']);
const openByDefault = new Set(['ceviz', 'gurok']);
const route = [
  { year: { en: '2024', tr: '2024' }, label: { en: 'University of Salerno', tr: 'Salerno Üniversitesi' }, c: 'var(--c11)', href: '#salerno' },
  { year: { en: '2025', tr: '2025' }, label: { en: 'Güral Porselen', tr: 'Güral Porselen' }, c: 'var(--c9)', href: '#gural' },
  { year: { en: '2025', tr: '2025' }, label: { en: 'Ceviz Biyoteknoloji · CTO', tr: 'Ceviz Biyoteknoloji · CTO' }, c: 'var(--lime)', href: '#ceviz' },
  { year: { en: '2026', tr: '2026' }, label: { en: 'Gürok Group · MES', tr: 'Gürok Grup · MES' }, c: 'var(--c8)', href: '#gurok' },
  { year: { en: '2026', tr: '2026' }, label: { en: 'International ML research', tr: 'Uluslararası ML araştırması' }, c: 'var(--c5)', href: '#ml-research' },
  { year: { en: 'Now', tr: 'Şimdi' }, label: { en: 'CTO + ML lead, in parallel', tr: 'CTO + ML liderliği, paralel' }, c: '#FFFFFF', href: '#ceviz', pulse: true },
];
---

<BaseLayout
  title="Experience"
  path="/experience"
  sheet="02"
  description="Experience of İsmail Özyurt — CTO at Ceviz Biyoteknoloji, ML research, internships at Gürok Group and Güral Porselen, and Erasmus+ research at the University of Salerno."
  descriptionTr="İsmail Özyurt’un deneyimi — Ceviz Biyoteknoloji’de CTO, makine öğrenmesi araştırması, Gürok Grup ve Güral Porselen stajları, Salerno Üniversitesi’nde Erasmus+ araştırması."
>
  <section class="wrap sheet head">
    <div class="sheet-row">
      <p class="k"><T en="Sheet 02 / 08 · Experience" tr="Sayfa 02 / 08 · Deneyim" /></p>
      <p class="k"><T en={`${experience.length} stops · 2024 → now`} tr={`${experience.length} durak · 2024 → bugün`} /></p>
    </div>
    <PrintTitle en="Experience, built deliberately." tr="Adım adım, bilerek kurduğum bir deneyim." size="clamp(52px, 8vw, 128px)" class="head-title" />
    <p class="lede head-p"><T en="Chronological, most recent first — role, organization, dates, and outcomes." tr="Kronolojik, en yeniden eskiye — rol, kurum, tarih ve çıktılar." /></p>
  </section>

  <section class="wrap route-sec" aria-label="Route overview">
    <div class="route-scroll">
      <div class="route">
        <span class="route-line" aria-hidden="true"></span>
        {route.map((r) => (
          <a class="stn" href={r.href}>
            <span class:list={['stn-dot', { pulse: r.pulse }]} style={`background: ${r.c}`} aria-hidden="true"></span>
            <span class="cond stn-year"><T t={r.year} /></span>
            <span class="stn-label"><T t={r.label} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap sec" aria-label="Timeline">
    <div class="tl-tools">
      <button type="button" class="tool" data-all="open"><T en="Expand all" tr="Tümünü aç" /></button>
      <button type="button" class="tool" data-all="close"><T en="Collapse all" tr="Tümünü kapat" /></button>
    </div>
    {experience.map((e: any) => {
      const id = e.slug ?? e.id;
      const points = (e.points ?? []).map(bi);
      return (
        <article class="stop" id={id} style={`--c: ${color[e.id] ?? 'var(--c6)'}`}>
          <div class="rail" aria-hidden="true">
            <span class="rail-bar"></span>
            <span class:list={['rail-dot', { pulse: now.has(e.id) }]}></span>
            <p class="cond per-l"><T t={bi(e.period)} /></p>
          </div>
          <div class="stop-body">
            <p class="cond per-s"><T t={bi(e.period)} /></p>
            <p class="k"><T t={bi(e.kind)} /></p>
            <h2 class="disp stop-role"><T t={bi(e.role)} /></h2>
            <p class="stop-org"><T t={bi(e.org)} /></p>
            <p class="muted stop-sum"><T t={bi(e.summary)} /></p>
            {points.length > 0 && (
              <details class="outcomes" open={openByDefault.has(e.id)}>
                <summary class="tool">
                  <span class="s-closed"><T en={`Show ${points.length} outcomes +`} tr={`${points.length} çıktıyı göster +`} /></span>
                  <span class="s-open"><T en="Hide outcomes −" tr="Çıktıları gizle −" /></span>
                </summary>
                <ol class="plain outcome-list">
                  {points.map((p: any, i: number) => (
                    <li><span class="cond outcome-n">{String(i + 1).padStart(2, '0')}</span><span><T t={p} /></span></li>
                  ))}
                </ol>
              </details>
            )}
            {e.tags?.length > 0 && <div class="chips">{e.tags.map((t: string) => <span class="chip">{t}</span>)}</div>}
            <div class="stop-links">
              {e.link && <a class="btn btn--ink btn--sm" href={e.link}><T t={bi(e.linkLabel)} /> →</a>}
              {e.slug && <a class="ulink" href={`/experience/${e.slug}`}><T en="View details →" tr="Detayları gör →" /></a>}
            </div>
          </div>
        </article>
      );
    })}
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-all]').forEach(function (b) {
      b.addEventListener('click', function () {
        var open = b.getAttribute('data-all') === 'open';
        document.querySelectorAll('details.outcomes').forEach(function (d) { d.open = open; });
      });
    });
  })();
</script>

<style>
  .head { padding-bottom: 32px; }
  .head :global(.head-title) { max-width: 1100px; }
  .head-p { margin-top: 28px; max-width: 620px; font-size: 19px; }

  .route-sec { padding-top: 24px; padding-bottom: 56px; }
  .route-scroll { overflow-x: auto; padding: 8px 0 4px; }
  .route { position: relative; min-width: 760px; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); padding-top: 34px; }
  .route-line {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 47px;
    height: 8px;
    border-radius: 8px;
    background: linear-gradient(90deg, var(--c11) 0 20%, var(--c9) 20% 40%, var(--lime) 40% 60%, var(--c8) 60% 80%, var(--c5) 80% 100%);
    outline: 1.5px solid var(--ink);
  }
  .stn { position: relative; display: flex; flex-direction: column; align-items: center; gap: 10px; min-height: 44px; text-align: center; text-decoration: none; }
  .stn-dot { width: 34px; height: 34px; margin-top: -8px; border: 3px solid var(--ink); border-radius: 50%; transition: transform 0.25s; }
  .stn:hover .stn-dot { transform: scale(1.15); }
  .stn-year { font-size: 22px; line-height: 1; }
  .stn-label { max-width: 150px; font-weight: 600; font-size: 13px; line-height: 1.3; }

  .pulse { animation: pulse 2s infinite; }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(11, 12, 16, 0.45); }
    70% { box-shadow: 0 0 0 14px rgba(11, 12, 16, 0); }
    100% { box-shadow: 0 0 0 0 rgba(11, 12, 16, 0); }
  }

  .tl-tools { display: flex; justify-content: flex-end; gap: 10px; padding: 16px 0; border-top: 6px solid var(--ink); }
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: 600 14px/1 var(--font-body);
    cursor: pointer;
  }
  .tool:hover { background: var(--paper-hover); }

  .stop { display: grid; grid-template-columns: 150px minmax(0, 1fr); scroll-margin-top: 24px; }
  .rail { position: relative; }
  .rail-bar { position: absolute; left: 21px; top: 0; bottom: 0; width: 8px; background: var(--c); border-inline: 1.5px solid var(--ink); }
  .rail-dot { position: absolute; left: 7px; top: 38px; width: 36px; height: 36px; border: 4px solid var(--ink); border-radius: 50%; background: var(--paper); }
  .per-l { position: absolute; left: 58px; top: 40px; max-width: 90px; font-size: 20px; line-height: 1.05; }
  .per-s { display: none; font-size: 18px; }
  .stop-body { min-width: 0; display: flex; flex-direction: column; gap: 14px; padding: 36px 0 44px; border-bottom: 1.5px solid var(--rule); }
  .stop-role { font-size: clamp(30px, 3.4vw, 50px); line-height: 0.9; letter-spacing: -0.035em; }
  .stop-org { font-weight: 700; font-size: 18px; }
  .stop-sum { max-width: 760px; font-size: 17px; line-height: 1.6; }

  .outcomes { display: flex; flex-direction: column; gap: 12px; }
  .outcomes summary { list-style: none; align-self: flex-start; width: fit-content; }
  .outcomes summary::-webkit-details-marker { display: none; }
  .outcomes[open] summary { background: var(--ink); color: var(--paper); }
  .outcomes[open] .s-closed, .outcomes:not([open]) .s-open { display: none; }
  .outcome-list { margin-top: 12px; display: grid; gap: 10px; max-width: 820px; }
  .outcome-list li { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 10px; font-size: 16px; line-height: 1.55; }
  .outcome-n { font-size: 18px; color: var(--ink-2); }

  .stop-links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }

  @media (max-width: 760px) {
    .stop { grid-template-columns: 44px minmax(0, 1fr); }
    .per-l { display: none; }
    .per-s { display: block; }
  }
</style>
